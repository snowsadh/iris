# Private local settings. Keep credentials out of Git.
# Copy to .env and fill locally; never paste credentials into chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Host ports for the local development services.
IRIS_WEB_PORT=52773
IRIS_SUPERSERVER_PORT=1972
MAILPIT_WEB_PORT=8025

# Used in notification links. Match IRIS_WEB_PORT when changing the local web port.
ALLFEDO_PUBLIC_URL=http://127.0.0.1:52773/allfedo/
